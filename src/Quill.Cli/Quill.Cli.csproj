<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Quill.Core\Quill.Core.csproj" />
    <ProjectReference Include="..\Quill.AzureDevOps\Quill.AzureDevOps.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Quill.Cli.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quill</ToolCommandName>
    <PackageId>Raeffs.Quill</PackageId>
    <Description>Azure DevOps Server CLI for coding agents.</Description>
    <PackageTags>azure-devops;azure-devops-server;work-items;pull-requests;backlog;markdown;json;cli;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Only the `any` package carries managed IL; embedded symbols make it
         step-able without a fifth artifact to push. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Mandatory, not optional: ToolPackageRuntimeIdentifiers fails NETSDK1047
         without it, so packing a RID package *is* the AOT compile. -->
    <PublishAot>true</PublishAot>
    <ToolPackageRuntimeIdentifiers>linux-x64;win-x64;any</ToolPackageRuntimeIdentifiers>
    <!-- Permanent. The default collapses each package's internals into a single
         IL2104 and hides the detail any future AOT investigation depends on. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- VerifyReferenceAotCompatibility is deliberately NOT set: IsAotCompatible
         assembly metadata is new in .NET 10, so anything targeting net8.0 or
         netstandard2.0 cannot carry it whatever its intent. The property would
         fire across most of the graph, including packages proven clean by running
         them. -->
  </PropertyGroup>

</Project>
